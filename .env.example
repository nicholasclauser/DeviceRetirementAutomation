# DeviceRetirementAutomation — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# --- Absolute API ---
# Region endpoint — match to your Absolute console login URL:
#   https://cc.absolute.com      → https://api.absolute.com        (default)
#   https://cc.us.absolute.com   → https://api.us.absolute.com
#   https://cc.eu2.absolute.com  → https://api.eu2.absolute.com
ABSOLUTE_API_BASE=https://api.absolute.com

# --- Cisco Secure Endpoint (AMP) ---
# Region endpoint:
#   US   → https://api.amp.cisco.com
#   EU   → https://api.eu.amp.cisco.com
#   APJC → https://api.apjc.amp.cisco.com
CISCO_AMP_API_BASE=https://api.amp.cisco.com

# --- SCCM ---
# Your SCCM site code (Get-CMSite | Select SiteCode)
SCCM_SITE_CODE=ABC

# --- Active Directory ---
# Full distinguished name of the OU where disabled computers are moved.
AD_DISABLED_COMPUTERS_OU=OU=Disabled Computers,OU=_Disabled,DC=corp,DC=example,DC=com

# --- Output ---
OUTPUT_DIR=.\out

# --- Optional ---
# Comma-separated hostname/serial patterns to always skip.
# Example: EXTRA_SKIP_PATTERNS=LABTEST,KIOSK01
EXTRA_SKIP_PATTERNS=
